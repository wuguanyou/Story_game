{
  "name": "interactive-story-starter",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,API -c cyan,magenta \"npm run dev -w frontend\" \"npm run dev -w backend\"",
